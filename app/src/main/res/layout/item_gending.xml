<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgItemLagu"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            android:src="@android:color/darker_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btnTogglePlay"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:text="▶" android:textSize="18sp"
            android:padding="0dp"
            android:backgroundTint="@color/bali_sage"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvItemJudul"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nama Gending Rare"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/bali_terracotta"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="@id/imgItemLagu"
            app:layout_constraintStart_toEndOf="@id/imgItemLagu"
            app:layout_constraintEnd_toStartOf="@id/btnTogglePlay" />

        <TextView
            android:id="@+id/tvItemDeskripsi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Deskripsi singkat mengenai makna gending..."
            android:textSize="14sp"
            android:textColor="@color/bali_text"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvItemJudul"
            app:layout_constraintStart_toEndOf="@id/imgItemLagu"
            app:layout_constraintEnd_toStartOf="@id/btnTogglePlay" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>