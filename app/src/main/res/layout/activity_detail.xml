<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bali_ivory"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgDetailLagu"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/tvDetailJudul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Judul Lagu"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/bali_terracotta"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/imgDetailLagu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvDetailDeskripsi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="Deskripsi lengkap atau lirik gending rare akan muncul di sini..."
        android:textSize="16sp"
        android:textColor="@color/bali_text"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvDetailJudul"
        app:layout_constraintBottom_toTopOf="@+id/btnBack" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kembali ke Katalog"
        android:backgroundTint="@color/bali_sage"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>